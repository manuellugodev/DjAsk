# PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env on your VPS and fill in the values

# Flask Backend Configuration
# Generate a secure secret key with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY
FLASK_ENV=production

# Database Configuration
# Option 1: SQLite (simple, good for small/medium traffic)
DATABASE_URL=sqlite:///djask.db

# Option 2: PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://djask_user:your_password@localhost:5432/djask_db

# Domain Configuration (replace with your actual domains)
# DOMAIN=yourdomain.com
# ADMIN_DOMAIN=admin.yourdomain.com
