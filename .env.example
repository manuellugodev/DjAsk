# Flask Backend Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=development

# Database Configuration
# For SQLite (development/small deployments):
DATABASE_URL=sqlite:///djask.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/djask

# CORS Settings (Optional - defaults to allow all)
# CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Frontend URLs (for reference - not used by backend)
# These are automatically detected by the frontend
# VITE_API_URL=http://localhost:5000/api
# VITE_SOCKET_URL=http://localhost:5000
